@model IEnumerable<Interviewerslot.Models.Sir>

@{
    ViewBag.Title = "Sir List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Sir List</h2>

    <a href="@Url.Action("Create","SirA")" class="btn btn-primary">
        + Add New Sir
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-bordered table-hover text-center">
            <thead class="table-dark">
                <tr>
                    <th>Sir Name</th>
                    <th>Phone</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="2" class="text-muted">
                            No Sir found
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SirName</td>
                            <td>@item.Phone</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>
