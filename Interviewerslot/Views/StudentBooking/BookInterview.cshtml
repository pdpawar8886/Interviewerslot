@{
    ViewBag.Title = "Book Interview";
}

<h2>Book Interview</h2>

<div>
    <label>Student</label>
    @Html.DropDownList("studentId",
        (SelectList)ViewBag.StudentList,
        "-- Select Student --",
        new { @class = "form-control", id = "studentId" })
</div>

<br />

<div>
    <label>Sir</label>
    @Html.DropDownList(
        "sirId",
        (SelectList)ViewBag.SirList,
        "-- Select Sir --",
        new { @class = "form-control", id = "sirId" }
    )
</div>

<br />

<div>
    <label>Date</label>
    <select id="dateDropdown" class="form-control">
        <option>-- Select Date --</option>
    </select>
</div>

<br />

<div>
    <label>Available Slots</label>
    <select id="slotDropdown" class="form-control">
        <option>-- Select Slot --</option>
    </select>
</div>



<br />

<button id="bookBtn" class="btn btn-success">
    Book Interview
</button>


<script src="~/Scripts/jquery-3.6.0.min.js"></script>

<script>
    $("#sirId").on("change", function () {

        var sirId = $(this).val();
        console.log("Sir Selected:", sirId);

        $("#dateDropdown").empty();

        if (sirId === "" || sirId === "0") return;

        $.get("/StudentBooking/GetDates", { sirId: sirId })
            .done(function (data) {
                console.log("Dates received:", data);

                $("#dateDropdown").append("<option>-- Select Date --</option>");
                $.each(data, function (i, v) {
                    $("#dateDropdown").append(
                        "<option value='" + v + "'>" + v + "</option>"
                    );
                });
            })
            .fail(function () {
                alert("GetDates failed");
            });
    });

    $("#dateDropdown").change(function () {
        var sirId = $("#sirId").val();
        var date = $(this).val();
        $("#slotDropdown").empty();

        $.get("/StudentBooking/GetSlots",
            { sirId: sirId, date: date },
            function (data) {
                $("#slotDropdown").append("<option>-- Select Slot --</option>");
                $.each(data, function (i, v) {
                    $("#slotDropdown").append(
                        "<option value='" + v.AvailabilityId + "'>" +
                        v.FromTime + " - " + v.ToTime +
                        "</option>"
                    );
                });
            });
    });

    $("#bookBtn").click(function () {
        var studentId = $("#studentId").val();
        var availabilityId = $("#slotDropdown").val();
        

        $.post("/StudentBooking/ConfirmBooking",
            { studentId: studentId, availabilityId: availabilityId },
            function (res) {
                alert(res);
                location.reload();
            });
    });
</script>
