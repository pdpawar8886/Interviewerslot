@model Interviewerslot.Models.SirAvailability

@{
    ViewBag.Title = "Add Sir Availability";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Add Sir Availability</h4>
                </div>

                <div class="card-body p-4">

                    @using (Html.BeginForm("AddAvailability", "Sir", FormMethod.Post))
                    {
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <!-- Sir -->
                        <div class="form-group mb-3">
                            <label class="fw-bold">Sir</label>
                            @Html.DropDownListFor(
                                m => m.SirId,
                                (SelectList)ViewBag.SirList,
                                "-- Select Sir --",
                                new { @class = "form-control" }
                            )
                        </div>

                        <!-- Date -->
                        <div class="form-group mb-3">
                            <label class="fw-bold">Date</label>
                            @Html.TextBoxFor(
                                m => m.AvailableDate,
                                "{0:yyyy-MM-dd}",
                                new { type = "date", @class = "form-control" }
                            )
                        </div>

                        <div class="row">
                            <!-- From Time -->
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="fw-bold">From Time</label>
                                    @Html.TextBoxFor(
                                        m => m.FromTime,
                                        new { type = "time", @class = "form-control" }
                                    )
                                </div>
                            </div>

                            <!-- To Time -->
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="fw-bold">To Time</label>
                                    @Html.TextBoxFor(
                                        m => m.ToTime,
                                        new { type = "time", @class = "form-control" }
                                    )
                                </div>
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100 mt-2">
                            Save Availability
                        </button>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>

</div>