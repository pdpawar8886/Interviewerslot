@model Interviewerslot.Models.InterviewBooking

@{
    ViewBag.Title = "Book Interview";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0">Book Interview</h4>
                </div>

                <div class="card-body">

                    <!-- ❌ Error Message -->
                    @if (ViewBag.ErrorMsg != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.ErrorMsg
                        </div>
                    }

                    <!-- ✅ Success Message (after redirect) -->
                    @if (TempData["SuccessMsg"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMsg"]
                        </div>
                    }

                    @using (Html.BeginForm())
                    {
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <!-- Student -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Student</label>
                            @Html.DropDownListFor(
                                m => m.StudentId,
                                (SelectList)ViewBag.StudentList,
                                "-- Select Student --",
                                new { @class = "form-control", required = "required" })
                        </div>

                        <!-- Sir -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Sir</label>
                            @Html.DropDownListFor(
                                m => m.SirId,
                                (SelectList)ViewBag.SirList,
                                "-- Select Sir --",
                                new { @class = "form-control", required = "required", id = "SirId" })
                        </div>

                        <!-- Slot -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Available Slot</label>
                            @Html.DropDownListFor(
                                m => m.AvailabilityId,
                                new SelectList(Enumerable.Empty<SelectListItem>()),
                                "-- Select Slot --",
                                new { @class = "form-control", required = "required", id = "slotDropdown" })
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-bold">
                            Book Interview
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
    $(document).ready(function () {

        // Sir change → load slots
        $("#SirId").change(function () {

            var sirId = $(this).val();

            $("#slotDropdown")
                .empty()
                .append('<option value="">-- Select Slot --</option>');

            if (sirId) {
                $.ajax({
                    url: '@Url.Action("GetSlotsBySir", "InterviewBooking")',
                    type: 'GET',
                    data: { sirId: sirId },
                    success: function (data) {

                        if (data.length === 0) {
                            $("#slotDropdown").append(
                                '<option value="">No slots available</option>');
                        }

                        $.each(data, function (i, slot) {
                            $("#slotDropdown").append(
                                '<option value="' + slot.AvailabilityId + '">' +
                                slot.SlotText +
                                '</option>');
                        });
                    }
                });
            }
        });

        // Auto hide success message
        setTimeout(function () {
            $(".alert-success").fadeOut();
        }, 3000);
    });
    </script>
}
